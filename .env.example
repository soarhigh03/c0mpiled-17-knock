# packages/server
PORT=8787
KNOCK_TOKEN_SECRET=change-me-dev-secret
KNOCK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# apps/meet
VITE_KNOCK_API_URL=http://localhost:8787

# apps/login-demo — 두 사람이 각자 노트북에서 실제로 통화할 때만.
# 기본값(주석 상태)은 BroadcastChannel: 한 머신의 두 창끼리만 통하고 영상은 안 옮깁니다.
# peer로 두면 WebRTC로 서로의 카메라가 뜹니다. 양쪽 .env에 똑같이 넣어야 합니다.
#
# 토큰 introspect가 머신 너머로 성립하려면 KNOCK_TOKEN_SECRET도 양쪽이 같아야 합니다.
#VITE_ROOM_TRANSPORT=peer
# 공개 브로커라 룸 id가 전역에서 겹칠 수 있습니다. "id가 이미 쓰이고 있다"가 뜨면 바꾸세요.
#VITE_ROOM_NAMESPACE=presense
